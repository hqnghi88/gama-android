# GAMA engine reflection surface.
#
# The GAML engine loads species, experiments, factories, delegates and the
# gaml.additions.<bundle>.GamlAdditions classes reflectively by string name
# (GamaNativeBootstrap). Guice, xtext, EMF and OSGi also use runtime
# reflection extensively. These namespaces must keep their names and members.

-keep class gama.** { *; }
-keep class gaml.** { *; }
-keep class com.gama.nativeapp.gui.AndroidGuiHandler { *; }
-keep class com.gama.nativeapp.display.GamaAndroidDisplaySetup { *; }
-keep class org.eclipse.core.** { *; }
-keep class org.eclipse.emf.** { *; }
-keep class org.eclipse.xtext.** { *; }
-keep class org.eclipse.xsd.** { *; }
-keep class org.eclipse.osgi.** { *; }
-keep class org.osgi.** { *; }
-keep class com.google.inject.** { *; }

# Keep attributes that reflection and the GAML parser rely on (annotations,
# signatures for generics, inner classes for nested prefs etc).
-keepattributes Signature,*Annotation*,InnerClasses,EnclosingMethod,Exceptions,AnnotationDefault,RuntimeVisibleAnnotations,RuntimeInvisibleAnnotations,RuntimeVisibleParameterAnnotations,RuntimeInvisibleParameterAnnotations,MethodParameters

# The engine intentionally avoids translator/step optimizations; turning them
# off reduces risk of VerifyError/NoSuchMethodError on the heavily reflected
# model classes.
-dontoptimize

# Android desugaring adds these; silence expected missing-class noise.
-dontwarn java.awt.**
-dontwarn javax.swing.**
-dontwarn java.beans.**
-dontwarn javax.sound.**
-dontwarn org.tritonus.**
-dontwarn org.osgi.framework.**
-dontwarn com.sun.**
-dontwarn org.apache.xerces.**
-dontwarn org.w3c.**
