<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.gama.nativeapp">

    <!-- Required for json_file(http://...) and other URL fetching via the Webb client. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- CORE FEATURE: GAMA is a full simulation/modeling IDE whose models (GAML
         files, GIS/CSV data, images, outputs) live on the device's shared storage
         wherever the user keeps them. The engine consumes model and resource paths
         as real filesystem paths (java.io.File), so on Android 11+ scoped storage
         (API 30+) the workspace folder the user chooses must be readable and
         writable as real paths, which requires All Files Access. This permission
         is declared and justified to Google Play as the core functionality of the
         app. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- The workspace lives in app-private storage (getFilesDir) by default;
         legacy read/write storage permissions are effective on API 26-32; the app
         still requests WRITE externally on those versions before picking a
         folder. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <application
        android:requestLegacyExternalStorage="true"
        android:name=".GamaApplication"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GAMA Native"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.GamaNative"
        android:windowSoftInputMode="adjustResize"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ModelNavigatorActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ModelEditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExperimentActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>

</manifest>
