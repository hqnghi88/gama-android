<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gama.nativeapp">

    <!-- Required for json_file(http://...) and other URL fetching via the Webb client. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- SAF-based workspace folder access via ACTION_OPEN_DOCUMENT_TREE.
         No MANAGE_EXTERNAL_STORAGE (All Files Access) and no legacy storage
         permissions are declared — the user picks a folder and the app receives
         a persisted URI permission to it, then mirrors it into app-private
         storage (real paths) for the GAMA engine. This is the
         Google-Play-policy-compliant path. -->
    <application
        android:name=".GamaApplication"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GAMA Native"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.GamaNative"
        android:windowSoftInputMode="adjustResize"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ModelNavigatorActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ModelEditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExperimentActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>

</manifest>
