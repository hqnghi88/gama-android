<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gama.nativeapp">

    <!-- Required for json_file(http://...) and other URL fetching via the Webb client. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required so the workspace can be moved to a folder on shared (primary)
         storage on Android 11+ (targetSdk 30+), where scoped storage otherwise
         blocks java.io.File access to /storage/emulated/0/. The GAMA engine
         consumes model paths as real File paths, so broad file access is needed
         when the user chooses a folder on device storage. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Legacy read/write storage permissions (effective on API 26-32; the app
         still requests WRITE externally on those versions before picking a folder). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <application
        android:requestLegacyExternalStorage="true"
        android:name=".GamaApplication"
        android:allowBackup="true"
        android:label="GAMA Native"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@style/Theme.GamaNative"
        android:windowSoftInputMode="adjustResize"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ModelNavigatorActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ModelEditorActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExperimentActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
    </application>

</manifest>
